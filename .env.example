# ====================
# Server Configuration
# ====================

PORT=5000
NODE_ENV=development

# PostgreSQL Database (Render)
DATABASE_URL=postgresql://user:password@host:5432/findit_db

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary (Image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Gmail - use App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Client URL (for CORS - set to your Render URL in production)
CLIENT_URL=http://localhost:5173

# ====================
# Client Configuration (optional - defaults work for same-origin deployment)
# ====================

# VITE_API_URL=/api
# VITE_SOCKET_URL=
